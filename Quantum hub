    Label.TextColor3 = Theme.TextPrimary
    Label.BackgroundTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local ValLabel = Instance.new("TextLabel", Frame)
    ValLabel.Size = UDim2.new(0.35, -12, 0, 24)
    ValLabel.Position = UDim2.new(0.65, 0, 0, 4)
    ValLabel.Text = tostring(default)
    ValLabel.Font = Enum.Font.GothamBold
    ValLabel.TextSize = 13
    ValLabel.TextColor3 = Theme.AccentSecondary
    ValLabel.BackgroundTransparency = 1
    ValLabel.TextXAlignment = Enum.TextXAlignment.Right
    
    local Track = Instance.new("Frame", Frame)
    Track.Size = UDim2.new(1, -24, 0, 6)
    Track.Position = UDim2.new(0, 12, 0, 36)
    Track.BackgroundColor3 = Theme.Sidebar
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)
    
    local Fill = Instance.new("Frame", Track)
    Fill.Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0)
    Fill.BackgroundColor3 = Theme.Accent
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + ((max - min) * pos))
        ValLabel.Text = tostring(val)
        Fill.Size = UDim2.new(pos, 0, 1, 0)
        callback(val)
    end
    
    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

local function CreateDropdown(page, text, options, default, callback)
    local Frame = Instance.new("Frame", page)
    Frame.Size = UDim2.new(1, 0, 0, 42)
    Frame.BackgroundColor3 = Theme.Card
    Frame.ClipsDescendants = true
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)
    ApplyStroke(Frame)
    
    local Label = Instance.new("TextLabel", Frame)
    Label.Size = UDim2.new(0.5, 0, 0, 42)
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Text = text
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 13
    Label.TextColor3 = Theme.TextPrimary
    Label.BackgroundTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local DropBtn = Instance.new("TextButton", Frame)
    DropBtn.Size = UDim2.new(0.4, 0, 0, 26)
    DropBtn.Position = UDim2.new(0.6, -10, 0, 8)
    DropBtn.BackgroundColor3 = Theme.Sidebar
    DropBtn.Text = default .. "  ▼"
    DropBtn.TextColor3 = Theme.AccentSecondary
    DropBtn.Font = Enum.Font.GothamBold
    DropBtn.TextSize = 12
    Instance.new("UICorner", DropBtn).CornerRadius = UDim.new(0, 6)
    
    local isOpen = false
    DropBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        TweenService:Create(Frame, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {
            Size = isOpen and UDim2.new(1, 0, 0, 42 + (#options * 32)) or UDim2.new(1, 0, 0, 42)
        }):Play()
        DropBtn.Text = default .. (isOpen and "  ▲" or "  ▼")
    end)
    
    for i, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton", Frame)
        OptBtn.Size = UDim2.new(1, -24, 0, 26)
        OptBtn.Position = UDim2.new(0, 12, 0, 42 + ((i - 1) * 30))
        OptBtn.BackgroundColor3 = Theme.Background
        OptBtn.Text = opt
        OptBtn.TextColor3 = Theme.TextSecondary
        OptBtn.Font = Enum.Font.Gotham
        OptBtn.TextSize = 12
        Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 6)
        
        OptBtn.MouseButton1Click:Connect(function()
            default = opt
            isOpen = false
            DropBtn.Text = opt .. "  ▼"
            TweenService:Create(Frame, TweenInfo.new(0.25), {Size = UDim2.new(1, 0, 0, 42)}):Play()
            callback(opt)
        end)
    end
end

local function CreateButton(page, text, callback)
    local Btn = Instance.new("TextButton", page)
    Btn.Size = UDim2.new(1, 0, 0, 40)
    Btn.BackgroundColor3 = Theme.Card
    Btn.Text = text
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 13
    Btn.TextColor3 = Theme.Accent
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
    ApplyStroke(Btn)
    
    Btn.MouseButton1Click:Connect(callback)
end

