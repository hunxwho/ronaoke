            local targetPos = ActiveRacePath[CurrentRaceNode]
            local targetVec = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
            local lookDir = (targetVec - root.Position).Unit
            
            if isCar then
                pcall(function()
                    if root.Anchored then root.Anchored = false end
                end)
                
                local currentLook = root.CFrame.LookVector
                local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z).Unit
                local flatTarget = Vector3.new(lookDir.X, 0, lookDir.Z).Unit
                local turnSpeed = flatLook:Cross(flatTarget).Y
                
                root.AssemblyAngularVelocity = Vector3.new(root.AssemblyAngularVelocity.X, turnSpeed * 16, root.AssemblyAngularVelocity.Z)
                root.AssemblyLinearVelocity = Vector3.new(lookDir.X * ModMaxSpeed, root.AssemblyLinearVelocity.Y, lookDir.Z * ModMaxSpeed)
            else
                root.CFrame = CFrame.lookAt(root.Position, targetVec)
                root.AssemblyLinearVelocity = Vector3.new(lookDir.X * ModMaxSpeed, root.AssemblyLinearVelocity.Y, lookDir.Z * ModMaxSpeed)
            end
            return
        end
        
        -- 2. UNIVERSAL CAR MODS (MOBILE TOUCH THROTTLE + PC HYBRID)
        if isCar and CarModsEnabled then
            local seat = hum and hum.SeatPart
            local throttle = 0
            
            if seat and seat:IsA("VehicleSeat") then
                if math.abs(seat.ThrottleFloat) > 0.05 then
                    throttle = seat.ThrottleFloat
                elseif math.abs(seat.Throttle) > 0 then
                    throttle = seat.Throttle
                end
            end
            
            -- Fallback / Keyboard & Mobile Joystick detection
            if throttle == 0 then
                if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then
                    throttle = 1
                elseif UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then
                    throttle = -1
                elseif hum and hum.MoveDirection.Magnitude > 0.1 then
                    local dot = root.CFrame.LookVector:Dot(hum.MoveDirection)
                    if dot > 0.15 then
                        throttle = 1
                    elseif dot < -0.15 then
                        throttle = -1
                    end
                end
            end
            
            if throttle ~= 0 then
                local currentVel = root.AssemblyLinearVelocity
                local look = root.CFrame.LookVector
                local flatVel = Vector3.new(currentVel.X, 0, currentVel.Z)
                local targetSpeed = throttle * ModMaxSpeed
                local targetVel = Vector3.new(look.X * targetSpeed, 0, look.Z * targetSpeed)
                
                local newVel = flatVel:Lerp(targetVel, math.clamp(ModAcceleration * deltaTime, 0, 1))
                root.AssemblyLinearVelocity = Vector3.new(newVel.X, currentVel.Y, newVel.Z)
            end
        end
        
        -- 3. CUSTOM WALKSPEED (C-WALK FOR BYPASS)
        if not isCar and hum and CustomWalkSpeed > 16 then
            hum.WalkSpeed = 16
            if hum.MoveDirection.Magnitude > 0 then
                local extraSpeed = CustomWalkSpeed - 16
                root.CFrame = root.CFrame + (hum.MoveDirection * (extraSpeed * deltaTime))
            end
        end
    end)
end)

