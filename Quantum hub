-- ====================== CORE UTILITIES ======================
local function getRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChild("Humanoid")
    if hum and hum.SeatPart then
        local veh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if veh and veh.PrimaryPart then
            return veh.PrimaryPart
        end
        return hum.SeatPart
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function stopMovement(part)
    if not part then return end
    pcall(function()
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function safeTP(targetCFrame)
    local char = LocalPlayer.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    if hum and hum.SeatPart then
        local vehicle = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if vehicle then
            stopMovement(vehicle.PrimaryPart)
            vehicle:PivotTo(targetCFrame)
            stopMovement(vehicle.PrimaryPart)
        else
            hum.SeatPart.CFrame = targetCFrame
        end
    else
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            stopMovement(root)
            root.CFrame = targetCFrame
            stopMovement(root)
        end
    end
end

-- ====================== MOBILE-OPTIMIZED PROXIMITY PROMPT ENGINE ======================
local function triggerPrompt(prompt)
    if not prompt or not prompt.Enabled then return end
    
    local holdTime = (prompt.HoldDuration and prompt.HoldDuration > 0) and prompt.HoldDuration or 0
    local oldLoS = prompt.RequiresLineOfSight
    local oldMaxDist = prompt.MaxActivationDistance
    
    pcall(function()
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 50
    end)
    
    local root = getRoot()
    
    if holdTime > 0.5 then
        -- Multi-second hold robbery prompt
        pcall(function() prompt:InputHoldBegin() end)
        
        local startTime = os.clock()
        while (os.clock() - startTime) < (holdTime + 0.35) do
            if root and prompt.Parent then
                root.CFrame = CFrame.new(prompt.Parent.Position + Vector3.new(0, 1.8, 0))
                stopMovement(root)
            end
            task.wait(0.04)
        end
        
        pcall(function() prompt:InputHoldEnd() end)
        
        if typeof(fireproximityprompt) == "function" then
            pcall(function() fireproximityprompt(prompt, holdTime, true) end)
        end
    else
        -- Instant loot bags / cash drops
        if typeof(fireproximityprompt) == "function" then
            pcall(function() fireproximityprompt(prompt, 0, true) end)
            pcall(function() fireproximityprompt(prompt) end)
        end
        
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.08)
            prompt:InputHoldEnd()
        end)
        
        if VIM then
            pcall(function()
                VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.08)
                VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)
        end
    end
    
    pcall(function()
        prompt.RequiresLineOfSight = oldLoS
        prompt.MaxActivationDistance = oldMaxDist
    end)
end

-- ====================== UNIVERSAL MONEY PICKUP ======================
local function pickupMoney(radius)
    local root = getRoot()
    if not root then return false end
    
    local centerPosition = root.Position
    local searchRadius = radius or 100
    local startTime = os.clock()
    local emptyCount = 0
    local foundAnyCash = false

    if root.Name == "HumanoidRootPart" then root.Anchored = true end

    while (os.clock() - startTime) < 7.5 do
        local cashBags = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local parent = obj.Parent
                if parent and (parent:IsA("BasePart") or parent:IsA("MeshPart")) then
                    if obj.HoldDuration <= 1.2 then
                        local name = parent.Name:lower()
                        local actText = obj.ActionText:lower()
                        local objText = obj.ObjectText:lower()
                        
                        if name:find("money") or name:find("cash") or name:find("bill") or name:find("bag") or name:find("loot") or
                           actText:find("take") or actText:find("steal") or actText:find("pick") or actText:find("collect") or 
                           actText:find("grab") or actText:find("interact") or actText:find("item") or actText:find("drop") or 
                           objText:find("cash") then
                            if (parent.Position - centerPosition).Magnitude <= searchRadius then
                                table.insert(cashBags, {Prompt = obj, Part = parent})
                            end
                        end
                    end
                end
            end
        end

        if #cashBags > 0 then
            foundAnyCash = true
            emptyCount = 0
            for _, bag in ipairs(cashBags) do
                if not bag.Prompt.Enabled then continue end
                root.CFrame = CFrame.new(bag.Part.Position + Vector3.new(0, 2.2, 0))
                stopMovement(root)
                task.wait(0.12)
                triggerPrompt(bag.Prompt)
                task.wait(0.08)
            end
        else
            emptyCount = emptyCount + 1
            task.wait(0.1)
            if emptyCount >= 25 then break end
        end
    end
    
    if root.Name == "HumanoidRootPart" then root.Anchored = false end
    return foundAnyCash
end

